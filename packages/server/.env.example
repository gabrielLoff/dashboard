# External API keys — fill these in to switch from mock to live data
# Note: GamerPower and Open-Meteo are free and require no key.
NEWSLETTER_API_KEY=
CURRENTS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Server port
PORT=3001

# Set to "true" to use mock data, "false" to call real APIs
MOCK=false

# Cache TTLs in seconds
CACHE_TTL_WEATHER=600
CACHE_TTL_NEWS=1800
CACHE_TTL_AGENDA=600
CACHE_TTL_GAMES=43200
